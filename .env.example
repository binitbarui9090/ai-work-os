# ─────────────────────────────────────────────────────────────────────────────
# AI WORK OS — environment configuration
# Copy to `.env` (repo root) and adjust. `npm run setup` works with these
# defaults as-is, except for the AI keys (see "AI PROVIDERS").
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── API server ──────────────────────────────────────────────────────────────
PORT=4000
# Public origin of the web app. Used for CORS, cookies and invite links.
WEB_ORIGIN=http://localhost:5173
# Public base URL of this API (used in OAuth redirect URIs and emails).
API_BASE_URL=http://localhost:4000

# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-session-secret-change-me-0123456789abcdef
# Session lifetime in days
SESSION_TTL_DAYS=30
# Set to `true` only when serving over HTTPS.
COOKIE_SECURE=false

# ── Postgres (docker-compose maps 5432 -> 55432) ────────────────────────────
DATABASE_URL=postgres://workos:workos@localhost:55432/workos
# Separate database used by `npm test`. Created automatically by the test setup.
TEST_DATABASE_URL=postgres://workos:workos@localhost:55432/workos_test

# ── Redis (docker-compose maps 6379 -> 56379) ───────────────────────────────
REDIS_URL=redis://localhost:56379

# ── AI PROVIDERS ─────────────────────────────────────────────────────────────
# Chat / reasoning model. `anthropic` is the reference implementation.
# Options: anthropic | openai-compatible | disabled
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# Effort for agent turns: low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
ANTHROPIC_API_KEY=
# Only for LLM_PROVIDER=openai-compatible
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Embeddings power semantic search + RAG.
# Options: voyage | openai | disabled
# When `disabled`, semantic search degrades to Postgres full-text search and the
# UI says so explicitly — nothing is faked.
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=voyage-3.5
EMBEDDING_DIMENSIONS=1024
VOYAGE_API_KEY=

# ── Object storage (S3-compatible; docker-compose runs MinIO) ────────────────
# Options: s3 | disabled
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=workos-uploads
S3_ACCESS_KEY_ID=workosminio
S3_SECRET_ACCESS_KEY=workosminio
S3_FORCE_PATH_STYLE=true
# Public base URL used to serve/download objects. For MinIO this is S3_ENDPOINT.
S3_PUBLIC_URL=http://localhost:59000

# ── Email (notifications + invites) ─────────────────────────────────────────
# Options: smtp | console | disabled
#   console → emails are logged to stdout (default for local dev)
EMAIL_PROVIDER=console
EMAIL_FROM="AI Work OS <no-reply@localhost>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ── Integrations (optional; see docs/INTEGRATIONS.md) ───────────────────────
# GitHub OAuth App: https://github.com/settings/developers
# Authorization callback URL: ${API_BASE_URL}/api/integrations/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Secret for validating GitHub webhook deliveries
GITHUB_WEBHOOK_SECRET=

# Google Cloud OAuth client (Web application)
# Redirect URI: ${API_BASE_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Background workers ──────────────────────────────────────────────────────
# Run workers inside the API process (convenient for local dev).
# In production run `npm run dev:worker` / `node dist/worker.js` separately.
RUN_WORKERS_INLINE=true
